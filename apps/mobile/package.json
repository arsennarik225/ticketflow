{
  "name": "biletflow-staff",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "export": "expo export --platform android --platform ios --max-workers 1"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-camera": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.20.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  }
}
