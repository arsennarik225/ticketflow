# Copy to the repository root as .env on the server. Do not commit it.
DOMAIN=tickets.example.kz
# Generate each separately with: openssl rand -hex 32
DB_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-random-hex
QR_SECRET=replace-with-random-hex
SEED_DEMO_DATA=false
SMTP_HOST=smtp.example.kz
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=tickets@example.kz
