# Copy to .env to override the defaults in docker-compose.yml. Every value is optional.

# Ports on your machine
DB_PORT=5433
API_PORT=8000
MAIL_UI_PORT=8025

# Where the web app runs: used in email links and inside Campaign QR codes
WEB_URL=http://localhost:3000
# Where this API is reachable: used for pdfUrl and qrImageUrl
API_URL=http://localhost:8000
# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS=*

# Change both for any shared or demo deployment (at least 32 characters)
JWT_SECRET=dev-only-jwt-secret-change-me-32bytes
QR_SECRET=dev-only-qr-secret-change-me-32bytes
